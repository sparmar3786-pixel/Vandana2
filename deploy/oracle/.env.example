# Public API DNS name pointing to the Oracle VM
API_DOMAIN=api.example.com

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DB_PATH=data/strategy_memory.sqlite

# Frontend/API CORS
CORS_ORIGINS=https://app.example.com

# Angel One SmartAPI — backend only
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
ANGEL_REFRESH_TOKEN=

# Supabase durable memory
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Six-layer AI
AI_ENABLED=on
GOOGLE_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
DEEPSEEK_API_KEY=
CLOUDFLARE_AI_API_KEY=
CLOUDFLARE_AI_BASE_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Keep live order placement disabled.
