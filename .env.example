# =============================================================
# nse-ai-terminal — environment template
# Copy to .env and fill in. NEVER commit .env with real secrets.
# =============================================================

# ---------- data source ----------
# one of: angel_one | nse_public | mcp | demo
DATA_SOURCE=angel_one
# data-source fallback order (comma separated), tried left-to-right
DATA_FALLBACK_ORDER=angel_one

# ---------- Angel One SmartAPI ----------
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
# optional: seed a refresh token if you already have one
ANGEL_REFRESH_TOKEN=
ANGEL_BASE_URL=https://apiconnect.angelone.in
ANGEL_WS_URL=wss://smartapisocket.angelone.in/smart-stream
ANGEL_PUBLISHER_LOGIN=https://smartapi.angelone.in/publisher-login

# ---------- engine ----------
# advanced (vol-surface, order-flow, vega, multi-leg, quant, microstructure, cross-index) layer
ADVANCED_ENGINE=on
# minimum *target* number of trade plans per cycle (never fabricated to reach it)
MIN_TRADE_PLANS=5
# locked Run60/Run93 risk gate constant
MIN_RR=1.8
# risk budget per trade and total, as fraction of capital
MAX_RISK_PER_TRADE=0.01
MAX_TOTAL_RISK=0.04
# default index lot sizes (override per index if your broker differs)
NIFTY_LOT_SIZE=25
BANKNIFTY_LOT_SIZE=15
FINNIFTY_LOT_SIZE=40
MIDCPNIFTY_LOT_SIZE=50
SENSEX_LOT_SIZE=10
BANKEX_LOT_SIZE=15

# ---------- live orders (KEEP OFF until validated) ----------
ENABLE_LIVE_ORDERS=0
REQUIRE_HUMAN_CONFIRM=1

# ---------- data quality gate ----------
MAX_TICK_AGE_SEC=5
MAX_SNAPSHOT_AGE_SEC=10
MAX_TICK_JUMP_PCT=5.0
RATE_LIMIT_RPS=8

# ---------- indices ----------
INDICES=NIFTY,BANKNIFTY,FINNIFTY,MIDCPNIFTY,SENSEX,BANKEX

# ---------- AI 6-layer validation ----------
AI_ENABLED=on
# backend transport: puter | direct
AI_TRANSPORT=direct
# Puter auth mode: browser_token | server_token
PUTER_AUTH_MODE=browser_token
PUTER_AUTH_TOKEN=
PUTER_API_BASE=https://api.puter.com

# model ids are NOT assumed permanent — resolve via listModels()/listModelProviders()
# at runtime, and/or override here. Layers may be blanked to disable a single model.
AI_MODEL_L1=gpt-5.6-luna
AI_MODEL_L2=claude-sonnet-4.6
AI_MODEL_L3=gpt-5.6-sol
AI_MODEL_L4=deepseek-chat
AI_MODEL_L5=gemini-2.5-flash
AI_MODEL_L6=grok-4
# enable web search tool for layers that support it
AI_WEB_SEARCH=on

# ---------- direct provider keys (fallback transport) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
# optional OpenAI-compatible base URL override (e.g. a proxy/gateway)
OPENAI_BASE_URL=

# ---------- MCP ----------
MCP_ENABLED=on
MCP_CONFIG_PATH=config/mcp_servers.json
NSE_MCP_TRANSPORT=streamable-http
NSE_MCP_SSE_PORT=8765

# ---------- APK/backend authentication ----------
TERMINAL_API_KEY=

# ---------- server ----------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DB_PATH=data/strategy_memory.sqlite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Point 3: environment configuration contract ----------
# This template is configuration-only. Put real credentials in .env or the
# deployment platform's secret manager; never commit real secrets.
